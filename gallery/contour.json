{
  "version": 1,
  "sources": {
    "mesh": {
      "file": "../testdata/vtk/hex_linear.vtu"
    }
  },
  "filters": {
    "iso": {
      "type": "contour",
      "input": "mesh",
      "field": "linear",
      "values": [2.5, 5.0, 7.5, 10.0]
    }
  },
  "view": {
    "show": [
      {
        "input": "iso",
        "style": "surface",
        "color_by": "linear",
        "colormap": "turbo",
        "range": [0.0, 12.0],
        "colorbar": {
          "title": "linear",
          "position": "right"
        }
      },
      {
        "input": "mesh",
        "style": "wireframe",
        "edge_color": "silver"
      }
    ],
    "camera": {
      "fit": "all",
      "azimuth": 35.0,
      "elevation": 24.0,
      "zoom": 1.0,
      "projection": "perspective"
    },
    "lights": "default",
    "background": "white",
    "axes": true,
    "title": "Multi-Isovalue Contour (linear = 2.5, 5, 7.5, 10)"
  },
  "output": {
    "image": "contour.png",
    "size": [800, 600],
    "time": "first",
    "msaa": 4,
    "engine": "raster"
  }
}
