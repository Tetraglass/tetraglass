{
  "version": 1,
  "sources": {
    "mesh": {
      "file": "../testdata/vtk/hex_linear.vtu"
    }
  },
  "filters": {
    "vol": {
      "type": "resample",
      "input": "mesh",
      "dimensions": [32, 32, 32]
    }
  },
  "view": {
    "show": [
      {
        "input": "vol",
        "style": "volume",
        "color_by": "linear",
        "colormap": "viridis",
        "range": [0.0, 12.0],
        "transfer_function": [
          [0.0, 0.0],
          [0.35, 0.12],
          [0.7, 0.45],
          [1.0, 0.9]
        ],
        "colorbar": {
          "title": "linear",
          "position": "right"
        }
      },
      {
        "input": "mesh",
        "style": "wireframe",
        "edge_color": "silver"
      }
    ],
    "camera": {
      "fit": "all",
      "azimuth": 35.0,
      "elevation": 24.0,
      "zoom": 1.0,
      "projection": "perspective"
    },
    "lights": "default",
    "background": "white",
    "axes": true,
    "title": "Volume Ray Marching (linear)"
  },
  "output": {
    "image": "volume.png",
    "size": [800, 600],
    "time": "first",
    "msaa": 4,
    "engine": "raster"
  }
}
