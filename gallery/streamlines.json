{
  "version": 1,
  "sources": {
    "mesh": {
      "file": "../testdata/vtk/hex_linear.vtu"
    }
  },
  "filters": {
    "traces": {
      "type": "streamlines",
      "input": "mesh",
      "vectors": "velocity",
      "seeds": {
        "plane": {
          "origin": [1.0, 1.0, 1.0],
          "normal": [-1.0, 1.0, 0.0],
          "extent": [1.4, 1.4],
          "count": [4, 4]
        }
      },
      "max_length": 4.0,
      "step_size": 0.03,
      "direction": "both",
      "integrator": "rk45",
      "tube_radius": 0.035
    }
  },
  "view": {
    "show": [
      {
        "input": "traces",
        "style": "tubes",
        "color_by": "velocity:magnitude",
        "colormap": "viridis",
        "range": [0.7, 2.15],
        "colorbar": {
          "title": "|velocity|",
          "position": "right"
        }
      },
      {
        "input": "mesh",
        "style": "wireframe",
        "edge_color": "silver"
      }
    ],
    "camera": {
      "fit": "all",
      "azimuth": 35.0,
      "elevation": 24.0,
      "zoom": 1.0,
      "projection": "perspective"
    },
    "lights": "default",
    "background": "white",
    "axes": true,
    "title": "Streamline Tubes (velocity, RK45)"
  },
  "output": {
    "image": "streamlines.png",
    "size": [800, 600],
    "time": "first",
    "msaa": 4,
    "engine": "raster"
  }
}
