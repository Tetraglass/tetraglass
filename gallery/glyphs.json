{
  "version": 1,
  "sources": {
    "mesh": {
      "file": "../testdata/vtk/hex_linear.vtu"
    }
  },
  "filters": {
    "arrows": {
      "type": "glyphs",
      "input": "mesh",
      "vectors": "velocity",
      "shape": "arrow",
      "scale_by": "magnitude",
      "every": 1
    }
  },
  "view": {
    "show": [
      {
        "input": "arrows",
        "style": "surface",
        "color_by": "velocity:magnitude",
        "colormap": "viridis",
        "range": [1.0, 2.83],
        "colorbar": {
          "title": "|velocity|",
          "position": "right"
        }
      },
      {
        "input": "mesh",
        "style": "wireframe",
        "edge_color": "silver"
      }
    ],
    "camera": {
      "fit": "all",
      "azimuth": 35.0,
      "elevation": 24.0,
      "zoom": 1.0,
      "projection": "perspective"
    },
    "lights": "default",
    "background": "white",
    "axes": true,
    "title": "Vector Arrow Glyphs (velocity)"
  },
  "output": {
    "image": "glyphs.png",
    "size": [800, 600],
    "time": "first",
    "msaa": 4,
    "engine": "raster"
  }
}
