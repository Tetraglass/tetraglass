{
  "version": 1,
  "sources": {
    "flow": {
      "file": "../testdata/vtk/series.pvd"
    }
  },
  "view": {
    "show": [
      {
        "input": "flow",
        "style": "surface",
        "color_by": "transient",
        "colormap": "viridis",
        "range": "auto_all_steps",
        "colorbar": {
          "title": "transient",
          "position": "right"
        }
      }
    ],
    "camera": {
      "fit": "all",
      "azimuth": 25.0,
      "elevation": 20.0,
      "zoom": 1.0,
      "projection": "perspective"
    },
    "lights": "default",
    "background": "white",
    "axes": true,
    "title": "PVD Time Series at t = 1.0 (last)"
  },
  "output": {
    "image": "series-transient-last.png",
    "size": [800, 600],
    "time": "last",
    "msaa": 4,
    "engine": "raster"
  }
}
